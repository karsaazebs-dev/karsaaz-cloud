# Karsaaz Cloud — Environment Variables
# Copy this file to .env and fill in your values before starting.
# NEVER commit .env — it contains real passwords.

# ── Karsaaz Cloud Admin ──
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=change-me-strong-password

# ── PostgreSQL Database ──
POSTGRES_DB=karsaazcloud
POSTGRES_USER=karsaazcloud
POSTGRES_PASSWORD=change-me-strong-password

# ── Trusted Domains (space-separated) ──
# Add your server's IP or domain here
NC_TRUSTED_DOMAINS=localhost 127.0.0.1 YOUR_SERVER_IP

# ── Host Port ──
NC_PORT=3030

# ── Collabora Online (Office engine) ──
COLLABORA_PORT=9980
COLLABORA_ADMIN_USER=karsaaz_admin
COLLABORA_ADMIN_PASSWORD=change-me-strong-password
