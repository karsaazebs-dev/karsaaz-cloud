# Karsaaz Cloud — Environment Variables
# Copy this file to .env and fill in your values before starting:
#   cp .env.example .env
# NEVER commit .env — it contains real passwords.

# ── Karsaaz Cloud Admin ──
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=change-me-strong-password

# ── PostgreSQL Database ──
POSTGRES_DB=karsaazcloud
POSTGRES_USER=karsaazcloud
POSTGRES_PASSWORD=change-me-strong-password

# ── Trusted Domains (space-separated) ──
# Include ERP frontend host so embed/CORS works (use real host/IP clients use).
NC_TRUSTED_DOMAINS=localhost 127.0.0.1 192.168.18.61

# ── Host Port ──
NC_PORT=3030

# ── Collabora Online (Office engine) ──
COLLABORA_PORT=9980
COLLABORA_ADMIN_USER=karsaaz_admin
COLLABORA_ADMIN_PASSWORD=change-me-strong-password
COLLABORA_PUBLIC_URL=http://localhost:9980

# ── Karsaaz ERP Bridge (karsaaz_erp_bridge app) ─────────────────────────────
# ERP registers a tenant via:
#   POST /ocs/v2.php/apps/karsaaz_erp_bridge/api/v1/register
# Credentials (api_key, hmac_secret, tenant_id) are returned once and stored in ERP Odoo.
#
# Must match D:\Dev\KarsaazErp-phae-one\.env:
#   KARSAAZ_ERP_BASE_URL          → webhook_url host + allowed_origins
#   KARSAAZ_CLOUD_ERP_JWT_SECRET  → erp_jwt_secret at registration (min 32 chars)
#   KARSAAZ_CLOUD_BASE_URL        → this stack's public URL (NC_PORT)
KARSAAZ_ERP_BASE_URL=http://host.docker.internal:3001
KARSAAZ_ERP_WEBHOOK_PATH=/karsaaz/cloud/webhook
KARSAAZ_ERP_JWT_SECRET=change-me-generate-32plus-chars-same-as-erp-KARSAAZ_CLOUD_ERP_JWT_SECRET
KARSAAZ_CLOUD_PUBLIC_URL=http://localhost:3030

# ── Integration test script (scripts/test-erp-integration.js) ───────────────
NC_BASE_URL=http://localhost:3030
WEBHOOK_HOST=host.docker.internal
WEBHOOK_PORT=9876
