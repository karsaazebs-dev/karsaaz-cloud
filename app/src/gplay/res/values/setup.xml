<resources>
    <!--
        Karsaaz Cloud has no upstream-Firebase relationship. The push_server_url
        is intentionally empty so the gplay flavor falls back to polling (same
        behavior as the generic / F-Droid flavor). All Google Cloud project IDs
        below are zero/placeholder; the upstream values (project nextcloud-a7dea,
        api key AIzaSyAW…) have been removed since they belong to Nextcloud GmbH
        and must not be used by a fork.

        If/when Karsaaz operates its own UnifiedPush / NTFY / Firebase project,
        wire it here. Until then, keep these placeholders so the build still
        resolves the symbols but nothing phones home.
    -->
    <!-- Push server url -->
    <string name="push_server_url" translatable="false"></string>

    <!-- Firebase / GCM placeholders (zero values; must be replaced if Karsaaz adopts FCM) -->
    <string name="default_web_client_id" translatable="false"></string>
    <string name="firebase_database_url" translatable="false"></string>
    <string name="gcm_defaultSenderId" translatable="false">0</string>
    <string name="google_api_key" translatable="false"></string>
    <string name="google_app_id" translatable="false">1:0:android:0</string>
    <string name="google_crash_reporting_api_key" translatable="false"></string>
    <string name="google_storage_bucket" translatable="false"></string>
    <string name="project_id" translatable="false"></string>
</resources>
